---
import bookIcon from '../assets/icons/book.svg';
import folderPlusIcon from '../assets/icons/folder-plus.svg';
import editIcon from '../assets/icons/edit.svg';
import monitorIcon from '../assets/icons/monitor.svg';
import phoneIcon from '../assets/icons/phone.svg';

const navItems = [
  { label: '书籍', href: '/books', icon: bookIcon },
  { label: '教程', href: '/tutorials', icon: folderPlusIcon },
  { label: '笔记', href: '/notes', icon: editIcon },
  { label: '应用', href: '/apps', icon: monitorIcon },
  { label: '联系', href: '/contact', icon: phoneIcon },
];

const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
// Detail pages live below their section, so a nav item stays current on them.
const isCurrent = (href: string) => currentPath === href || currentPath.startsWith(`${href}/`);
---

<header class="header">
  <div class="header__inner">
    <a class="header__title" href="/">阿伟哥的站点</a>
    <nav class="header__nav">
      {
        navItems.map(({ label, href, icon }) => (
          <a class="nav-item" href={href} aria-current={isCurrent(href) ? 'page' : undefined}>
            <span class="nav-item__icon" style={`--icon: url("${icon.src}")`} />
            <span class="nav-item__label">{label}</span>
          </a>
        ))
      }
    </nav>
  </div>
</header>

<style>
  .header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    /* 100px tall, but free to grow when the nav wraps on narrow viewports. */
    min-height: 100px;
    padding: 10px var(--gutter);
    background-color: var(--chrome-bg);
    border-bottom: 1px solid var(--chrome-line);
  }

  .header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    row-gap: 12px;
    width: 100%;
    padding: 10px 0;
  }

  .header__title {
    margin: 0;
    color: var(--chrome-ink);
    font-size: var(--font-size-h1);
    font-weight: var(--font-weight-h1);
    line-height: var(--line-height-h1);
    text-decoration: none;
  }

  .header__nav {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 28px;
  }

  .nav-item {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--chrome-muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .nav-item:hover {
    color: var(--chrome-ink);
  }

  /* The design marks the current page by recolouring the icon and the label
     together, so the icon is masked and painted with currentColor. */
  .nav-item[aria-current='page'] {
    color: var(--chrome-accent);
  }

  .nav-item__icon {
    display: block;
    flex-shrink: 0;
    width: 32px;
    height: 32px;
    background-color: currentColor;
    -webkit-mask-image: var(--icon);
    -webkit-mask-repeat: no-repeat;
    -webkit-mask-position: center;
    mask-image: var(--icon);
    mask-repeat: no-repeat;
    mask-position: center;
  }

  .nav-item__label {
    font-size: var(--font-size-title);
    font-weight: var(--font-weight-title);
    line-height: var(--line-height-title);
    white-space: nowrap;
  }

  @media (max-width: 720px) {
    .header {
      min-height: 0;
    }

    .header__title {
      font-size: 28px;
      line-height: 36px;
    }

    .header__nav {
      column-gap: 18px;
      row-gap: 10px;
    }

    .nav-item {
      gap: 6px;
    }

    .nav-item__icon {
      width: 22px;
      height: 22px;
      -webkit-mask-size: contain;
      mask-size: contain;
    }

    .nav-item__label {
      font-size: 17px;
      line-height: 24px;
    }
  }
</style>
