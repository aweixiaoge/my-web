---
import { getNotes } from '../lib/notes';

interface Props {
  limit?: number;
}

const { limit } = Astro.props;
// slice(0, undefined) returns everything, so an absent limit means "all notes".
const notes = (await getNotes()).slice(0, limit);
---

<section class="notes">
  <h2 class="page-heading">笔记</h2>
  <div class="notes__list">
    {
      notes.map((note) => (
        <article class="note">
          <div class="note__meta">
            <p class="note__date">
              <span>{note.day}</span>
              <span>{note.month}</span>
            </p>
            <p class="note__author">{note.author}</p>
          </div>
          <div class="note__content">
            <h3 class="note__title">{note.title}</h3>
            <p class="note__excerpt">{note.excerpt}</p>
            <a class="note__link pill-link" href={note.href}>
              Read more
            </a>
          </div>
        </article>
      ))
    }
  </div>
</section>

<style>
  .notes {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .notes__list {
    display: flex;
    flex-direction: column;
    padding: 8px 40px;
    background: var(--card-bg);
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
  }

  .note {
    display: flex;
    align-items: flex-start;
    gap: 32px;
    padding: 32px 0;
  }

  .note + .note {
    border-top: 1px solid var(--line);
  }

  .note__meta {
    display: flex;
    flex: 0 0 55px;
    flex-direction: column;
    align-items: flex-end;
    gap: 15px;
  }

  .note__date {
    display: flex;
    flex-direction: column;
    width: 100%;
    margin: 0;
    color: var(--ink);
    font-size: var(--font-size-h2);
    font-weight: var(--font-weight-h2);
    line-height: var(--line-height-h2);
    text-align: right;
  }

  .note__date span + span {
    color: var(--accent);
    font-size: var(--font-size-body);
    font-weight: var(--font-weight-body-bold);
    line-height: var(--line-height-body);
  }

  /* The handle is a 55x55 box whose text sits bottom-right, then the whole box
     is rotated -90deg, which reads the handle bottom-to-top down the column. */
  .note__author {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    width: 55px;
    height: 55px;
    margin: 0;
    transform: rotate(-90deg);
    color: var(--muted);
    font-size: 14px;
    font-weight: var(--font-weight-body);
    line-height: 20px;
    text-align: right;
  }

  .note__content {
    display: flex;
    flex: 0 1 1057px;
    min-width: 0;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
  }

  .note__title {
    width: 100%;
    margin: 0;
    color: var(--ink);
    font-size: 22px;
    font-weight: var(--font-weight-h2);
    line-height: 30px;
  }

  .note__excerpt {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    overflow: hidden;
    width: 100%;
    margin: 0;
    color: var(--muted);
    font-size: var(--font-size-body);
    font-weight: var(--font-weight-body);
    line-height: 26px;
  }

  .note__link {
    margin-top: 6px;
  }

  @media (max-width: 720px) {
    .notes__list {
      padding: 0 20px;
    }

    .note {
      gap: 16px;
      padding: 24px 0;
    }

    .note__meta {
      flex-basis: 44px;
    }

    .note__date {
      font-size: var(--font-size-title);
      line-height: var(--line-height-title);
    }

    .note__title {
      font-size: 20px;
      line-height: 28px;
    }
  }
</style>
