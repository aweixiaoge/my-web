---
import bookStack from '../assets/book-stack.png';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  description: string;
  href: string;
  cover?: ImageMetadata;
  coverFit?: 'contain' | 'cover';
}

const { title, description, href, cover, coverFit = 'contain' } = Astro.props;
---

<a class="tutorial" href={href}>
  <div class="tutorial__media">
    <img
      class:list={['tutorial__image', cover && coverFit === 'cover' && 'tutorial__image--fill']}
      src={cover?.src ?? bookStack.src}
      alt=""
    />
  </div>
  <div class="tutorial__text">
    <h3 class="tutorial__title">{title}</h3>
    <p class="tutorial__description">{description}</p>
  </div>
</a>

<style>
  .tutorial {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: var(--card-bg);
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
    color: var(--ink);
    text-decoration: none;
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease;
  }

  .tutorial:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-card-hover);
  }

  .tutorial__media {
    width: 100%;
    height: 260px;
    overflow: hidden;
    background: linear-gradient(160deg, var(--tint), var(--tint-deep));
  }

  .tutorial__image {
    display: block;
    width: 100%;
    height: 100%;
    padding: 28px;
    object-fit: contain;
    filter: var(--shadow-cover);
  }

  .tutorial__image--fill {
    padding: 0;
    object-fit: cover;
    filter: none;
  }

  .tutorial__text {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 24px 28px 28px;
  }

  .tutorial__title {
    margin: 0;
    font-size: 22px;
    font-weight: var(--font-weight-h2);
    line-height: 30px;
    transition: color 0.2s ease;
  }

  .tutorial:hover .tutorial__title {
    color: var(--accent);
  }

  .tutorial__description {
    margin: 0;
    color: var(--muted);
    font-size: var(--font-size-body);
    font-weight: var(--font-weight-body);
    line-height: 26px;

    display: -webkit-box;
    -webkit-line-clamp: 3;        /* 最多显示 3 行 */
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;      /* 超出显示省略号 */
  }

  @media (max-width: 720px) {
    .tutorial__media {
      height: 220px;
    }
  }
</style>
